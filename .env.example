# ===========================================
# PolicyPulse CRM - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ===========================================

# Database - Neon PostgreSQL connection string
DATABASE_URL=postgresql://username:password@host.neon.tech/neondb?sslmode=require

# ===========================================
# Better Auth Authentication
# ===========================================
# Secret key for signing tokens (SERVER ONLY - never expose to client!)
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_better_auth_secret_key

# Social OAuth Providers (Optional)
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# ===========================================
# Paddle (Payment Processor)
# ===========================================
# API key (SERVER ONLY)
PADDLE_API_KEY=pdl_live_xxx

# Client-side token for checkout (safe for client)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=pdl_ct_xxx

# Webhook secret (SERVER ONLY)
PADDLE_WEBHOOK_SECRET=pdl_whsec_xxx

# Price IDs - Server-side (used in webhooks)
PADDLE_SOLO_PRICE_ID=pri_xxx_solo
PADDLE_GROWTH_PRICE_ID=pri_xxx_growth
PADDLE_ENTERPRISE_PRICE_ID=pri_xxx_enterprise

# Price IDs - Client-side (for checkout display)
NEXT_PUBLIC_PADDLE_SOLO_PRICE_ID=pri_xxx_solo
NEXT_PUBLIC_PADDLE_GROWTH_PRICE_ID=pri_xxx_growth
NEXT_PUBLIC_PADDLE_ENTERPRISE_PRICE_ID=pri_xxx_enterprise

# ===========================================
# Email - Resend
# ===========================================
# API key (SERVER ONLY)
RESEND_API_KEY=re_your_resend_api_key

# ===========================================
# AI - Google Gemini
# ===========================================
# API key (SERVER ONLY)
GEMINI_API_KEY=your_gemini_api_key

# ===========================================
# AI - DashScope (Qwen - Alternative)
# ===========================================
# API key (SERVER ONLY)
DASHSCOPE_API_KEY=sk-your_dashscope_api_key

# ===========================================
# Background Jobs - Inngest
# ===========================================
# Event key (SERVER ONLY)
INNGEST_EVENT_KEY=evn_xxx

# Signing key (SERVER ONLY)
INNGEST_SIGNING_KEY=sign_xxx

# App ID
INNGEST_APP_ID=policypulse

# ===========================================
# File Storage - Backblaze B2
# ===========================================
# Access credentials (SERVER ONLY)
B2_ACCESS_KEY_ID=your_access_key_id
B2_SECRET_ACCESS_KEY=your_secret_access_key

# Bucket configuration
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_BUCKET_NAME=your-bucket-name
B2_PUBLIC_URL=https://your-bucket.s3.us-west-004.backblazeb2.com

# ===========================================
# Application
# ===========================================
# Public URL (safe for client)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment
NODE_ENV=development

# ===========================================
# IP Whitelist
# ===========================================
# Comma-separated list of IP addresses allowed to access the application
# Example: 192.168.1.1, 10.0.0.1
IP_WHITELIST=

# Admin IP whitelist for sensitive operations (comma-separated IPs and CIDR ranges)
# Example: "192.168.1.1,10.0.0.0/8,1.2.3.4"
# Leave empty to disable IP whitelisting for admin operations
ADMIN_IP_WHITELIST=

# CORS - Allowed origins for cross-origin requests
# Comma-separated list of allowed origins
# Example: "https://yourdomain.com,https://app.yourdomain.com"
ALLOWED_ORIGINS=

# Redis - For caching and performance optimization
# Example: redis://localhost:6379 or redis://user:password@host:port
REDIS_URL=

# Backblaze B2 Storage - Primary file storage (cost-effective)
# Backblaze B2 is S3-compatible and significantly cheaper than alternatives
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET_NAME=policypulse-storage
B2_REGION=us-west-004
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com

# Cloudflare CDN - Optional CDN for Backblaze B2 (recommended for performance)
# Configure Cloudflare to proxy your Backblaze B2 bucket
CDN_URL=https://cdn.yourdomain.com

# ===========================================
# SECURITY NOTES:
# ===========================================
# 1. Variables with NEXT_PUBLIC_ prefix are exposed to the browser
# 2. NEVER put secret keys in NEXT_PUBLIC_ variables
# 3. All API keys, secrets, and credentials must be SERVER ONLY
# 4. Rotate all keys before deploying to production
# 5. Use different keys for development and production
# 6. Enable 2FA on all services (Better Auth, Paddle, etc.)
